{
  "name": "auto-ai-optout",
  "private": false,
  "homepage": "https://github.com/pyamsoft/auto-ai-optout",
  "version": "0.0.1",
  "type": "module",
  "description": "An MV3 extension which \"opts-out\" of data training and personalization on AI websites",
  "scripts": {
    "dev": "vite --mode development build",
    "build:chrome": "__CHROME__=1 vite --mode production build",
    "build:firefox": "__FIREFOX__=1 vite --mode production build",
    "lint:eslint": "eslint --report-unused-disable-directives --max-warnings 0 --cache --cache-strategy content .",
    "lint:oxlint": "oxlint --deny-warnings .",
    "lint:tsc": "tsc --strict --noEmit",
    "lint": "$npm_execpath run lint:oxlint && $npm_execpath run lint:tsc && $npm_execpath run lint:eslint",
    "format:all": "$npm_execpath run format .",
    "format": "prettier -w"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.1.43",
    "@types/node": "25.9.2",
    "eslint": "10.5.0",
    "npm-check-updates": "22.2.3",
    "oxlint": "1.68.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vite": "8.0.16"
  },
  "packageManager": "pnpm@11.5.2"
}
